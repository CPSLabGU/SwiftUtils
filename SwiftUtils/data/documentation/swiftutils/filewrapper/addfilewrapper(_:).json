r in the directory’s list of file wrappers. The","type":"text"},{"text":" ","type":"text"},{"text":"dictionary key is a unique filename, which is the same as the passed-in file wrapper’s","type":"text"},{"text":" ","type":"text"},{"text":"preferred filename unless that name is already in use as a key in the directory’s","type":"text"},{"text":" ","type":"text"},{"text":"dictionary of children. See Accessing File Wrapper Identities in File System Programming","type":"text"},{"text":" ","type":"text"},{"text":"Guide for more information about the file-wrapper list structure.","type":"text"}]}],"kind":"content"},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Use this method to add an existing file wrapper as a child of a directory file wrapper. If the file","type":"text"},{"text":" ","type":"text"},{"text":"wrapper does not have a preferred filename, set the ","type":"text"},{"identifier":"doc:\/\/SwiftUtils\/documentation\/SwiftUtils\/FileWrapper\/preferredFilename","type":"reference","isActive":true},{"text":" property to give it one","type":"text"},{"text":" ","type":"text"},{"text":"before calling ","type":"text"},{"identifier":"doc:\/\/SwiftUtils\/documentation\/SwiftUtils\/FileWrapper\/addFileWrapper(_:)","type":"reference","isActive":true},{"text":". To create a new file wrapper and add it to a directory, use the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"addRegularFile(withContents:preferredFilename:)"},{"text":" method.","type":"text"}]}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swiftutils\/filewrapper\/addfilewrapper(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiftUtils/documentation/SwiftUtils/FileWrapper":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FileWrapper","kind":"identifier"}],"navigatorTitle":[{"text":"FileWrapper","kind":"identi